APP_ENV=production
APP_DEBUG=false
APP_URL=https://viki.example.com
APP_KEY=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://viki.example.com
TOKEN_TTL_MINUTES=720

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=feedhub
DB_USER=feedhub_user
DB_PASS=change-me
DB_CHARSET=utf8mb4

SUPERADMIN_EMAILS=admin@example.com
SUPERADMIN_PERMISSIONS=store.access,store.context,permissions.read,catalog.read,catalog.write,products.read,products.write,categories.read,categories.write,connections.read,connections.write,imports.run,backups.manage
